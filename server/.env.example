# IronForge server secrets — copy to server as ~/ironforge/server/.env, chmod 600
# NEVER commit this file. Never put it in the docker image (mounted via env_file).

# Comma-separated pairs generated on first boot: create with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=<random hex 64 chars>

# First-run bootstrap (file /data/bootstrap.json is created by deploy from these)
# BOOTSTRAP_USERNAME=mjonir
# BOOTSTRAP_PASSWORD=<your strong password, min 10 chars>

# Optional: override defaults
# PORT=8420
# BIND=0.0.0.0
# DATA_DIR=/data
