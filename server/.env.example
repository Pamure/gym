# IronForge server secrets — copy to server as ~/ironforge/server/.env, chmod 600
# NEVER commit this file. Never put it in the docker image (mounted via env_file).

# Comma-separated pairs generated on first boot: create with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=<random hex 64 chars>

# First-run bootstrap (file /data/bootstrap.json is created by deploy from these)
# BOOTSTRAP_USERNAME=mjonir
# BOOTSTRAP_PASSWORD=<your strong password, min 10 chars>

# Optional: enable IronCoach on the server. Keep this key server-side only;
# never put it in app/lib, API_BASE, Flutter --dart-define, or server/web.
# OPENROUTER_API_KEY=<paste-your-key-here>
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Only :free models are allowed; Nemotron 3 Ultra :free is the fallback.
# AI_SEARCH is intentionally ignored: online search is not verified free.

# Optional: override defaults
# PORT=8420
# BIND=0.0.0.0
# DATA_DIR=/data
